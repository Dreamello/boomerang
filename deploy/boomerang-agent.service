[Unit]
Description=boomerang relay/destination agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd reads the key as root and re-exposes it under $CREDENTIALS_DIRECTORY
# owned by this service's user, mode 0400. That is what lets the agent run
# unprivileged while the key stays root-owned.
#
# ${CREDENTIALS_DIRECTORY} rather than the %d specifier: %d arrived in systemd
# 250, so a unit using it is REJECTED AT PARSE TIME on Debian 11 (systemd 247)
# with "Failed to resolve unit specifiers in %d/key: Invalid slot" -- and a
# drop-in cannot rescue it, because the base file fails to parse first. The
# environment variable is set by 247 and by everything newer.
LoadCredential=key:/etc/boomerang.key
ExecStart=/usr/local/bin/boomerang --agent --port 8888 --key-file ${CREDENTIALS_DIRECTORY}/key
Restart=always
RestartSec=2

# The agent needs one UDP socket and one credential.
DynamicUser=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

# Port 8888 is unprivileged, so the agent binds with no capabilities at all.

[Install]
WantedBy=multi-user.target
